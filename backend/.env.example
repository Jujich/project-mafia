# PostgreSQL connection string used by Prisma.
# Use the host, database and role configured for your local PostgreSQL instance.
DATABASE_URL="postgresql://mafia:mafia@localhost:5432/mafia?schema=public"

# Port the NestJS server listens on.
PORT=3000

# Required barrier for the mobile snapshot endpoint (503 when missing).
# Android must receive the same value as NUXT_PUBLIC_MOBILE_SYNC_TOKEN;
# the public frontend BFF uses NUXT_MOBILE_SYNC_TOKEN on the server only.
MOBILE_SYNC_TOKEN=replace-with-a-long-random-value
