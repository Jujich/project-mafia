# URL of the NestJS backend the Nitro BFF proxies to.
# Locally this is http://localhost:3000; inside docker-compose it is the
# container name: http://mafia-backend:3000
NUXT_BACKEND_API_URL=http://localhost:3000

# Server-only credential for the public Nitro sync proxy. Must match the
# MOBILE_SYNC_TOKEN configured on NestJS. Docker Compose maps the GitLab
# MOBILE_SYNC_TOKEN variable to this runtime variable automatically.
NUXT_MOBILE_SYNC_TOKEN=replace-with-a-long-random-value

# Single-admin login gate for the host panel. Access to the app is only
# granted after entering these credentials.
# In production these are provided as GitLab CI/CD variables (this file is
# git-ignored and never deployed).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Secret used to seal the session cookie. Optional — if omitted it is derived
# from the admin credentials. Set an explicit long (>= 32 chars) random value
# in production so the session survives admin-password changes.
# SESSION_PASSWORD=

# Capacitor-only: public HTTPS origin of the protected Nuxt sync proxy
# (without trailing /api). Do not expose NestJS data routes directly.
# These values are compiled into the APK by `npm run android:sync`.
NUXT_PUBLIC_SYNC_API_URL=https://mafia.jujichservices.ru

# Must match NUXT_MOBILE_SYNC_TOKEN on Nitro and MOBILE_SYNC_TOKEN on NestJS.
# Use a separate mobile-only value, NEVER a GitLab/access/admin token. Because
# it is embedded in the APK, it is not a full per-user authentication mechanism.
NUXT_PUBLIC_MOBILE_SYNC_TOKEN=replace-with-a-long-random-value
